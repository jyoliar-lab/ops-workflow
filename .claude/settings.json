{
  "permissions": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-remote:*)",
      "Bash(git remote:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(pwd)",
      "Bash(env)",
      "Bash(pbcopy)",
      "Bash(gh pr create)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(grep:*)",
      "Bash(cd:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(gh issue view:*)",
      "Bash(list-subjects.py:*)",
      "Bash(next-id.py:*)",
      "Bash(doc-path.py:*)",
      "Bash(freeze-check.py:*)",
      "WebSearch",
      "WebFetch",
      "Fetch",

      "Bash(gh issue view:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(gh repo list:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/refresh-refs.py\""
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-path.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-write.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/reindex-docs.py\""
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "obs-toolkit": {
      "source": { "source": "github", "repo": "jyoliar-lab/obs-toolkit", "sha": "bee7059bd493cc43c239fc5923473d30730f4b7a" }
    }
  },
  "enabledPlugins": { "obs-toolkit@obs-toolkit": true }
}
