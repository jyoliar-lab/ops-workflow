{
  "permissions": {
    "allow": [
      "Bash(git log:*)", "Bash(git diff:*)", "Bash(git branch:*)", "Bash(git show:*)", "Bash(git status:*)",
      "Bash(git fetch:*)", "Bash(git rev-parse:*)", "Bash(git rev-list:*)", "Bash(git ls-remote:*)", "Bash(git remote:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)", "Bash(which:*)", "Bash(echo:*)",
      "Bash(find:*)", "Bash(pwd)", "Bash(env)", "Bash(jq:*)", "Bash(yq:*)", "Bash(grep:*)", "Bash(cd:*)",
      "Bash(awk:*)", "Bash(sort:*)", "Bash(uniq:*)",
      "Bash(gh issue view:*)", "Bash(gh issue list:*)", "Bash(gh pr view:*)", "Bash(gh pr list:*)",
      "Bash(gh run view:*)", "Bash(gh run list:*)", "Bash(gh run watch:*)",
      "Bash(gh release view:*)", "Bash(gh release list:*)", "Bash(gh repo list:*)",
      "WebSearch", "WebFetch", "Fetch",
      "Bash(list-subjects.py:*)", "Bash(freeze-check.py:*)",
      "Bash(accept.py:*)", "Bash(unaccept.py:*)", "Bash(supersede.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "sh \"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --show-toplevel)/.claude/hooks/session-path.sh\"" }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit|MultiEdit|Bash", "hooks": [
        { "type": "command", "command": "python3 \"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --show-toplevel)/.claude/hooks/guard-write.py\"" }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit|Bash", "hooks": [
        { "type": "command", "command": "python3 \"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --show-toplevel)/.claude/hooks/reindex-docs.py\"" }
      ] }
    ]
  }
}
